# =============================================================
# Tardmart – Production Environment Variables
# Copy this file to .env and fill in real values before deploying.
# NEVER commit .env to version control.
# =============================================================

# ── PostgreSQL ────────────────────────────────────────────────
POSTGRES_DB=tardmart
POSTGRES_USER=tardmart
POSTGRES_PASSWORD=CHANGE_THIS_STRONG_DB_PASSWORD

# ── Backend (FastAPI) ─────────────────────────────────────────
# Must match POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB above
DATABASE_URL=postgresql+asyncpg://tardmart:CHANGE_THIS_STRONG_DB_PASSWORD@db:5432/tardmart

# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_THIS_TO_A_64_CHAR_HEX_STRING

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Comma-separated list of allowed frontend origins (no trailing slash)
# Example: https://tardmart.example.com,https://www.tardmart.example.com
CORS_ORIGINS=http://YOUR_VPS_IP_OR_DOMAIN

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ── Frontend (Vite build-time) ────────────────────────────────
# The URL the browser uses to reach the API.
# In production with nginx on the same host this is just /api —
# nginx proxies /api/* to the backend container.
VITE_API_URL=
